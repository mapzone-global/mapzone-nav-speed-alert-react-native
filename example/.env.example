# Copy to .env (gitignored) and fill in real values.
NAV_BASE_URL=https://example.invalid
NAV_API_KEY_ID=
NAV_API_KEY=
# The signed-in user, passed to configure() as identity
NAV_IDENTITY=
# AlertVehicleType: CAR 1, TAXI 2, BUS 3, COACH 4, TRUCK 5, MOTORCYCLE 7
NAV_VEHICLE_TYPE=1
NAV_SEATS=5
# Tonnes
NAV_WEIGHTS_TONS=1.5
# 0 = server default
NAV_MAX_SNAP_METERS=0
# Optional: override the segment endpoint only (https). Empty = default under NAV_BASE_URL
NAV_SEGMENT_URL=
